{
  "common": {
    "name": "anycubic-cloud",
    "version": "0.2.0",
    "news": {
      "0.2.0": {
        "en": "First public beta: robust reconnect with backoff, plain-text status, dead-man watchdog, token-expiry warning",
        "de": "Erste öffentliche Beta: robuster Reconnect mit Backoff, Klartext-Status, Totmann-Wächter, Token-Ablauf-Warnung"
      },
      "0.1.2": {
        "en": "First version: reads printer status, print job and ACE (filament usage per slot) over the Anycubic cloud, read-only",
        "de": "Erste Version: liest Druckerstatus, Druckauftrag und ACE (Filamentverbrauch je Slot) über die Anycubic-Cloud, nur lesend"
      }
    },
    "titleLang": {
      "en": "Anycubic Cloud",
      "de": "Anycubic Cloud"
    },
    "desc": {
      "en": "Anycubic printers (Kobra S1 + ACE Pro) via the Anycubic cloud, read-only",
      "de": "Anycubic-Drucker (Kobra S1 + ACE Pro) über die Anycubic-Cloud, nur lesend"
    },
    "authors": [
      "Hendrik"
    ],
    "keywords": [
      "anycubic",
      "kobra",
      "3d printer",
      "ace pro"
    ],
    "platform": "Javascript/Node.js",
    "icon": "anycubic-cloud.svg",
    "extIcon": "https://raw.githubusercontent.com/hwiedermann/ioBroker.anycubic-cloud/main/admin/anycubic-cloud.svg",
    "enabled": true,
    "mode": "daemon",
    "type": "hardware",
    "compact": false,
    "connectionType": "cloud",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "tier": 3,
    "loglevel": "info",
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.0.0"
      }
    ],
    "licenseInformation": {
      "type": "free",
      "license": "GPL-3.0-or-later"
    }
  },
  "native": {
    "token": "",
    "restMinuten": 10,
    "tokenWarnTage": 14
  },
  "encryptedNative": [
    "token"
  ],
  "protectedNative": [
    "token"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "MQTT verbunden",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
